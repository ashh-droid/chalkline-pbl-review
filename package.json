{
  "name": "chalkline-pbl-review",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Chalkline — PBL programme review and traceable grant reporting based on a synthetic PBL programme dataset",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node server.mjs",
    "dev": "npm run build && npm run start",
    "test": "node --test tests/*.test.mjs",
    "import": "python3 scripts/import_data.py",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "build:data": "node scripts/build_light.mjs",
    "build:fonts": "node scripts/build_fonts.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "prettier": "^3.6.2",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0"
  }
}
